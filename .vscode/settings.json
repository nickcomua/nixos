{
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "editor.formatOnSave": true,
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": [
          "nix",
          "fmt",
          "--",
          "-"
        ]
      },
      "nixpkgs": {
        "expr": "import (builtins.getFlake \"/home/nick/.config/nixos\").inputs.nixpkgs {}"
      },
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake \"/home/nick/.config/nixos\").nixosConfigurations.nixos.options"
        },
        "home-manager": {
          "expr": "(builtins.getFlake \"/home/nick/.config/nixos\").nixosConfigurations.nixos.options.home-manager.users.type.getSubOptions []"
        }
      }
    }
  },
  "nixEnvSelector.nixFile": "${workspaceFolder}/flake.nix"
}